#!/bin/bash
## Description: Install dependencies and migrate the database
## Usage: setup
## Example: "ddev setup"

set -e

echo "Installing backend dependencies..."
cd /var/www/html/backend
composer install

if [ ! -f .env.local ]; then
    echo "Generating a credential encryption key..."
    printf 'CREDENTIALS_ENCRYPTION_KEY=%s\n' "$(php -r 'echo bin2hex(random_bytes(32));')" > .env.local
fi

echo "Migrating the database..."
php bin/console doctrine:migrations:migrate --no-interaction --allow-no-migration

echo "Preparing the test database..."
php bin/console doctrine:database:create --env=test --if-not-exists
php bin/console doctrine:migrations:migrate --env=test --no-interaction --allow-no-migration

echo "Installing frontend dependencies..."
cd /var/www/html/frontend
npm ci

echo ""
echo "Ready. Run 'ddev dev' to start the frontend with hot reload."
