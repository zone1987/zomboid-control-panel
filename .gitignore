/.idea/
.DS_Store

# Generated by ddev; contains local service credentials.
/.env.local

# Browser automation artefacts: console logs and page snapshots from
# manual verification runs. Diagnostic only, never part of the project.
.playwright-mcp/

# Studied for how others solved things, never copied and never shipped.
# Clone it back with:
#   git clone --depth 1 https://github.com/fpsacha/zomboid-control-panel.git reference/zomboid-control-panel
/reference/

# Screenshots from verification runs. Evidence for a conversation, not
# part of the project -- CONTEXT.md records what they showed.
/*.png

# Scratch task list. What is open belongs in CONTEXT.md, which is the
# one place a new session reads.
/TODO.md

# The operator's own Project Zomboid installations, placed here so both
# the host and the ddev container can read them -- the schema generator
# needs the game's files and javap, and neither exists in both places
# otherwise. Two are expected, and they are not interchangeable:
#
#   installations/local/   the desktop game: has projectzomboid.jar, the
#                          settings screen and every translation, so it
#                          is what the schema is generated from
#   installations/server/  the dedicated server build: fewer files, and
#                          the one whose option set a server actually
#                          has. Worth diffing against local when a value
#                          the panel offers is refused by the server.
#
# The artwork and code are The Indie Stone's and never belong in a
# repository; see CLAUDE.md 10b.
/installations/

# Written by .github/scripts/start-image.sh when run locally.
/procs.txt
