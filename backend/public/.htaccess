DirectoryIndex index.php

<IfModule mod_negotiation.c>
    Options -MultiViews
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Existing files are served as they are: the SPA bundle, its assets,
    # and anything else on disk.
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # /app without a trailing slash would otherwise fall through to the
    # API front controller, which has no route for it.
    RewriteRule ^app$ /app/ [R=301,L]

    # Client-side routes resolve to the SPA entry point. Guarding against
    # index.html itself stops the rewrite from matching its own target,
    # which loops until Apache gives up with a 500.
    RewriteCond %{REQUEST_URI} ^/app/
    RewriteCond %{REQUEST_URI} !^/app/index\.html$
    RewriteCond %{DOCUMENT_ROOT}/app/index.html -f
    RewriteRule ^ /app/index.html [L]

    RewriteCond %{REQUEST_URI}::$0 ^(/.+)/(.*)::\2$
    RewriteRule .* - [E=BASE:%1]

    RewriteCond %{HTTP:Authorization} .+
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%0]

    RewriteCond %{ENV:REDIRECT_STATUS} =""
    RewriteRule ^index\.php(?:/(.*)|$) %{ENV:BASE}/$1 [R=301,L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ %{ENV:BASE}/index.php [L]
</IfModule>

<IfModule !mod_rewrite.c>
    <IfModule mod_alias.c>
        RedirectMatch 307 ^/$ /index.php/
    </IfModule>
</IfModule>
