<!doctype html>
<html lang="{{ locale|default('en') }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ subject }}</title>
</head>
<body style="margin:0;padding:24px;background:#f4f4f5;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#18181b;">
    <table role="presentation" cellpadding="0" cellspacing="0" style="max-width:520px;margin:0 auto;background:#ffffff;border-radius:12px;border:1px solid #e4e4e7;">
        <tr>
            <td style="padding:24px 28px 8px;">
                <p style="margin:0;font-size:13px;font-weight:600;letter-spacing:.02em;color:#71717a;text-transform:uppercase;">
                    {{ appName }}
                </p>
            </td>
        </tr>
        <tr>
            <td style="padding:0 28px 20px;">
                <h1 style="margin:0 0 12px;font-size:20px;line-height:1.3;">{{ heading }}</h1>
                {% block content %}{% endblock %}
            </td>
        </tr>
        <tr>
            <td style="padding:0 28px 24px;">
                <p style="margin:0;font-size:12px;line-height:1.6;color:#71717a;">
                    {{ footer }}
                </p>
            </td>
        </tr>
    </table>
</body>
</html>
