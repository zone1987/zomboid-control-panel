# Copy to .env and fill in before running docker compose.
# In Coolify these become the application's environment variables.

# openssl rand -hex 16
APP_SECRET=

# openssl rand -hex 32
# Encrypts stored FTP and RCON passwords. Changing it makes existing
# credentials unreadable, so keep a backup.
CREDENTIALS_ENCRYPTION_KEY=

POSTGRES_DB=zomboid
POSTGRES_USER=zomboid
POSTGRES_PASSWORD=

# Public URL, including scheme. Used for links in invitation mails.
APP_PUBLIC_URL=https://zomboid.example.com

# Apache ServerName and the WebAuthn relying party id.
# The relying party id is the bare domain: no scheme, no port.
SERVER_NAME=zomboid.example.com
WEBAUTHN_RELYING_PARTY_ID=zomboid.example.com
WEBAUTHN_RELYING_PARTY_NAME=ZomboidControl

# smtp://user:pass@host:587 — URL-encode special characters in the password.
MAILER_DSN=
MAIL_FROM_ADDRESS=noreply@zomboid.example.com
MAIL_FROM_NAME=ZomboidControl

OAUTH_GOOGLE_ID=
OAUTH_GOOGLE_SECRET=

# Optional; enables Steam profile names and avatars after login.
STEAM_WEB_API_KEY=

APP_PORT=8080
MESSENGER_WORKERS=1
PHP_FPM_API_MAX_CHILDREN=12
PHP_FPM_SSE_MAX_CHILDREN=8
