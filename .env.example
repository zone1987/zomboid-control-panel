# Copy to .env before running docker compose.
# In Coolify these become the application's environment variables.

# ---------------------------------------------------------------------
# The only value you have to set
# ---------------------------------------------------------------------

# The address people actually type, including the scheme. Used for links
# in invitation mails, for Discord's interaction URL, and to derive the
# web server name and the passkey relying party id.
#
# On Coolify this can stay empty: COOLIFY_URL holds the domain you
# configured there and is used instead.
APP_PUBLIC_URL=https://zomboid.example.com

# ---------------------------------------------------------------------
# Everything below is optional
# ---------------------------------------------------------------------

# Generated on first start and kept in the `secrets` volume when left
# empty. Set them only to move an existing installation to a new host --
# APP_SECRET is `openssl rand -hex 16`, the key `openssl rand -hex 32`.
#
# The encryption key protects the stored FTP and RCON passwords. Whether
# you set it or the container made it, keep a copy: a database backup
# restored without it loses those passwords. A generated one is shown in
# the panel under Settings -> Security.
APP_SECRET=
CREDENTIALS_ENCRYPTION_KEY=

# The database password is generated when left empty. Set one to choose
# it yourself, or point DATABASE_URL at an external PostgreSQL.
POSTGRES_PASSWORD=
DATABASE_URL=
POSTGRES_DB=zomboid
POSTGRES_USER=zomboid

# Derived from APP_PUBLIC_URL. Set them only when the panel answers on a
# different name than the one people type. The relying party id is the
# bare domain: no scheme, no port.
SERVER_NAME=
WEBAUTHN_RELYING_PARTY_ID=
WEBAUTHN_RELYING_PARTY_NAME=ZomboidControl

# The published host port, used only with docker-compose.local.yaml.
# The base compose file publishes nothing, because a reverse proxy routes
# to the container's exposed port 80 and a claimed port fails the whole
# deployment when something already holds it.
APP_PORT=8080

# Raise these for a busy installation or several game servers.
MESSENGER_WORKERS=1
PHP_FPM_API_MAX_CHILDREN=12
PHP_FPM_SSE_MAX_CHILDREN=8

# Mail, Google sign-in and the Steam Web API key are configured in the
# panel itself, under Settings -- each with a test button beside it.
